# MODE=mock runs fully offline with a seeded demo account (no keys needed for the
# safety engine; Gemini enhances language understanding when a key is present).
# MODE=sandbox uses real PayPal sandbox credentials.
MODE=mock
PORT=3000
HOST=127.0.0.1

# Spoken passphrase required for high-risk payments (e.g. "blue harbor seven").
# Mock mode uses a demo phrase if unset; sandbox refuses high-risk payments if unset.
CLARIO_PASSPHRASE=

# Audit log (audit.jsonl) and the contacts file live here. Point this at a mounted
# volume on your host (e.g. /var/data on Render, /data on Hugging Face Spaces) or
# both reset on every redeploy.
CLARIO_DATA_DIR=data

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model IDs churn quickly; run `npm run check-models` to see what your key can reach.
GEMINI_FAST_MODEL=gemini-flash-latest
GEMINI_REVIEW_MODEL=gemini-pro-latest

# --- Hugging Face (https://huggingface.co/settings/tokens) ---
# Token for the Hugging Face API / Spaces deploy. Leave blank if unused.
HF_TOKEN=

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Enable "Transaction Search" on the REST app, or reporting calls return 403.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
