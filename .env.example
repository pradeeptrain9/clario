# MODE=mock runs fully offline with a seeded demo account (no keys needed for the
# safety engine; Gemini enhances language understanding when a key is present).
# MODE=sandbox uses real PayPal sandbox credentials.
MODE=mock
PORT=3000

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Model IDs churn quickly; run `npm run check-models` to see what your key can reach.
GEMINI_FAST_MODEL=gemini-flash-latest
GEMINI_REVIEW_MODEL=gemini-pro-latest

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Enable "Transaction Search" on the REST app, or reporting calls return 403.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
